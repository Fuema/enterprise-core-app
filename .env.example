# -----------------------------------------------------------------------------
# Copy to .env.local (all modes) or .env.<mode>.local and fill in every value.
# Every key is validated by src/lib/env.schema.ts; a missing or malformed value
# stops `npm run dev` and `npm run build` immediately.
# Only VITE_* keys reach the browser. Never put secrets here.
# -----------------------------------------------------------------------------

# Application
VITE_APP_NAME=Enterprise Core

# HTTP API
# The sample .NET API (enterprise-core-app-claude-server) listens on http://localhost:7077/api
VITE_API_BASE_URL=http://localhost:7077/api
VITE_API_TIMEOUT_MS=30000
# Casing the backend uses on the wire: camel | pascal | snake | none
VITE_API_PROPERTY_CASING=camel
# true when every response is wrapped in { data, success, message, errors }
VITE_API_RESPONSE_ENVELOPE=false

# Multi-tenancy: subdomain | path | none
VITE_TENANT_STRATEGY=none
VITE_TENANT_HEADER_NAME=X-Tenant-ID
# Required only for the subdomain strategy (acme.app.example.com -> "acme")
VITE_TENANT_ROOT_DOMAIN=

# Authentication endpoints (relative to VITE_API_BASE_URL)
VITE_AUTH_LOGIN_PATH=/auth/login
VITE_AUTH_REFRESH_PATH=/auth/refresh
VITE_AUTH_LOGOUT_PATH=/auth/logout
VITE_AUTH_ME_PATH=/auth/me
# Self-service signup (optional; defaults shown). Set to false to hide /signup.
VITE_AUTH_REGISTER_PATH=/auth/register
VITE_AUTH_SIGNUP_ENABLED=true

# Real-time hub base URL (leave empty to disable SignalR/WebSocket features)
VITE_HUB_BASE_URL=
VITE_HUB_MAX_RETRY_DELAY_MS=30000
VITE_HUB_MAX_RETRIES=10

# Data layer
VITE_QUERY_STALE_TIME_MS=30000
VITE_DEFAULT_PAGE_SIZE=20

# Browser storage key prefix
VITE_STORAGE_NAMESPACE=enterprise-core

# Development only: in-browser mock backend (MSW). Ignored by production builds.
# Demo users: admin/admin, manager/manager, viewer/viewer (the .NET API seeds the same users in Development)
# true = in-browser mock API; false = the real API at VITE_API_BASE_URL
VITE_ENABLE_MOCKS=false
